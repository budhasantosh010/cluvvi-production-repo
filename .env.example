# Active local Cluvvi runtime
CLUVVI_DEV_HOST=127.0.0.1
CLUVVI_DEV_PORT=3100
CLUVVI_ENGINE_MODE=fixture
CLUVVI_HOME=.cluvvi

# Added in C1; keep empty until a provider is configured
CLUVVI_LLM_BASE_URL=
CLUVVI_LLM_API_KEY=
CLUVVI_LLM_MODEL=
CLUVVI_LLM_TIMEOUT_MS=90000

# Parked Phase 0 Supabase placeholders
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Parked Phase 0 application defaults
APP_BASE_URL=http://localhost:3100
LOG_LEVEL=info
DEFAULT_RUN_BUDGET_USD=25
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEALTH_PORT=3001
