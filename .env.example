# Active local Cluvvi runtime
CLUVVI_DEV_HOST=127.0.0.1
CLUVVI_DEV_PORT=3100
CLUVVI_ENGINE_MODE=fixture
CLUVVI_HOME=.cluvvi

# Discovery runtime. Fixture remains the safe default.
CLUVVI_DISCOVERY_MODE=fixture
CLUVVI_DISCOVERY_PROVIDER_MODE=fixture_only
CLUVVI_DISCOVERY_PROVIDER_POLICY=free_only
CLUVVI_DISCOVERY_ENGINE_PATH=
CLUVVI_DISCOVERY_ENGINE_COMMAND=pnpm
CLUVVI_DISCOVERY_ENGINE_TIMEOUT_MS=60000
CLUVVI_DISCOVERY_KEEP_EXCHANGE_FILES=false
CLUVVI_DISCOVERY_EXTRACTION_MODE=none
CLUVVI_DISCOVERY_MAX_EXTRACTIONS=8
CLUVVI_DISCOVERY_STRUCTURED_CONTENT_MODE=none
CLUVVI_DISCOVERY_MAX_STRUCTURED_RESOURCES=8
CLUVVI_DISCOVERY_MAX_DOCUMENT_RESOURCES=4
CLUVVI_DISCOVERY_SOURCE_ADAPTER_MODE=none
CLUVVI_DISCOVERY_SOURCE_FAMILIES=
CLUVVI_DISCOVERY_MAX_HIRING_TARGETS=10
CLUVVI_DISCOVERY_MAX_HIRING_BOARDS_PER_TARGET=4
CLUVVI_DISCOVERY_MAX_HIRING_JOBS_PER_BOARD=250
CLUVVI_DISCOVERY_MAX_HIRING_JOBS_TOTAL=2000

# Optional non-secret Project A provider settings. Project A loads paid keys from its own ignored
# .env.local. Cluvvi never receives, forwards, logs, or persists Tavily or Brave keys.
DISCOVERY_LIVE_PROVIDERS=hacker_news_algolia,hacker_news_firebase,searxng_search,duckduckgo_html_search,startpage_html_search,tavily_search,brave_web_search
DISCOVERY_HTTP_TIMEOUT_MS=15000
DISCOVERY_HTTP_MAX_ATTEMPTS=2
DISCOVERY_HTTP_CONCURRENCY=2
DISCOVERY_LIVE_MAX_QUERIES=2
DISCOVERY_MAX_RESULTS_PER_PROVIDER=3
DISCOVERY_HN_ALGOLIA_MAX_REQUESTS_PER_RUN=2
DISCOVERY_HN_FIREBASE_MAX_ITEMS_PER_RUN=3
DISCOVERY_SEARXNG_URL=
DISCOVERY_SEARXNG_TIMEOUT_MS=15000
DISCOVERY_SEARXNG_MAX_REQUESTS_PER_RUN=2
DISCOVERY_DDG_ENABLED=true
DISCOVERY_DDG_TIMEOUT_MS=15000
DISCOVERY_DDG_MAX_REQUESTS_PER_RUN=2
DISCOVERY_STARTPAGE_ENABLED=true
DISCOVERY_STARTPAGE_TIMEOUT_MS=15000
DISCOVERY_STARTPAGE_MAX_REQUESTS_PER_RUN=2
DISCOVERY_FREE_SEARCH_MIN_RESULTS=5
DISCOVERY_FREE_SEARCH_MIN_UNIQUE_DOMAINS=3
DISCOVERY_FREE_SEARCH_MAX_DUPLICATE_RATIO=0.70
DISCOVERY_FREE_SEARCH_MIN_RELEVANT_RATIO=0.40
DISCOVERY_FREE_SEARCH_MAX_HTML_BYTES=2097152
DISCOVERY_FREE_SEARCH_MAX_JSON_BYTES=2097152
DISCOVERY_TAVILY_MAX_REQUESTS_PER_RUN=2
DISCOVERY_BRAVE_MAX_REQUESTS_PER_RUN=2
DISCOVERY_TAVILY_SEARCH_DEPTH=basic
DISCOVERY_BROAD_PROVIDER_STRATEGY=tavily_first

# Optional C1-I public-page extraction limits. These are non-secret and are forwarded only
# when CLUVVI_DISCOVERY_EXTRACTION_MODE=selected_public_pages.
DISCOVERY_EXTRACTION_MAX_URLS_PER_QUERY=3
DISCOVERY_EXTRACTION_MAX_URLS_PER_DOMAIN=2
DISCOVERY_EXTRACTION_MIN_PRIORITY=0.45
DISCOVERY_EXTRACTION_TIMEOUT_MS=15000
DISCOVERY_EXTRACTION_MAX_ATTEMPTS=2
DISCOVERY_EXTRACTION_MAX_CONCURRENCY=3
DISCOVERY_EXTRACTION_MAX_DOMAIN_CONCURRENCY=1
DISCOVERY_EXTRACTION_MIN_DOMAIN_DELAY_MS=500
DISCOVERY_EXTRACTION_MAX_REDIRECTS=5
DISCOVERY_EXTRACTION_MAX_HTML_BYTES=3145728
DISCOVERY_EXTRACTION_MAX_TEXT_CHARACTERS=50000
DISCOVERY_EXTRACTION_MIN_USEFUL_CHARACTERS=200
DISCOVERY_EXTRACTION_RESPECT_ROBOTS=true
DISCOVERY_EXTRACTION_ROBOTS_FAILURE_POLICY=allow_with_warning
DISCOVERY_EXTRACTION_USER_AGENT=UniversalDiscoveryEngine/1.0

# Optional C1-I.5 structured HTML/document parser limits. These are non-secret and are forwarded
# only when CLUVVI_DISCOVERY_STRUCTURED_CONTENT_MODE=selected_resources.
DISCOVERY_STRUCTURED_MAX_RESOURCES=8
DISCOVERY_STRUCTURED_MAX_DOCUMENT_RESOURCES=4
DISCOVERY_DOCUMENT_MAX_BYTES=20971520
DISCOVERY_DOCUMENT_PARSE_TIMEOUT_MS=30000
DISCOVERY_DOCUMENT_WORKER_MAX_ATTEMPTS=1
DISCOVERY_MARKDOWN_MAX_CHARACTERS=250000
DISCOVERY_SECTIONS_MAX_PER_RESOURCE=2000
DISCOVERY_TABLES_MAX_PER_RESOURCE=100
DISCOVERY_LINKS_MAX_PER_RESOURCE=5000
DISCOVERY_FOOTNOTES_MAX_PER_RESOURCE=1000
DISCOVERY_ASSETS_MAX_PER_RESOURCE=1000
DISCOVERY_TABLE_MAX_ROWS=2000
DISCOVERY_TABLE_MAX_COLUMNS=100
DISCOVERY_TABLE_MAX_CELL_CHARACTERS=10000
DISCOVERY_TABLE_MAX_TOTAL_CELLS=100000
DISCOVERY_HTML_MARKDOWN_ENABLED=true
DISCOVERY_ANYDOC_ENABLED=true
DISCOVERY_ANYDOC_WORKER_CONCURRENCY=1

# Optional C1-J.1 public hiring/ATS limits. These are non-secret and are forwarded only when
# CLUVVI_DISCOVERY_SOURCE_ADAPTER_MODE=selected_sources and the hiring family is enabled.
# SmartRecruiters authentication is intentionally absent: Project A owns its ignored secret locally.
DISCOVERY_HIRING_MAX_TARGETS=10
DISCOVERY_HIRING_MAX_BOARDS_PER_TARGET=3
DISCOVERY_HIRING_MAX_JOBS_PER_BOARD=250
DISCOVERY_HIRING_MAX_TOTAL_JOBS=2000
DISCOVERY_HIRING_MAX_DISCOVERY_QUERIES_PER_TARGET=2
DISCOVERY_HIRING_MAX_CONVENTIONAL_PATH_PROBES=4
DISCOVERY_HIRING_PROVIDER_TIMEOUT_MS=15000
DISCOVERY_HIRING_MAX_CONCURRENCY=4
DISCOVERY_HIRING_MAX_DOMAIN_CONCURRENCY=1
DISCOVERY_HIRING_DESCRIPTION_MAX_CHARACTERS=50000
DISCOVERY_HIRING_TOTAL_DESCRIPTION_MAX_CHARACTERS=10000000
DISCOVERY_HIRING_INCLUDE_PUBLIC_COMPENSATION=true
DISCOVERY_HIRING_ALLOW_AUTHENTICATED_FREE=true
DISCOVERY_HIRING_MIN_TARGET_CONFIDENCE=0.60
DISCOVERY_HIRING_MIN_BOARD_RELATIONSHIP_CONFIDENCE=0.60

# Optional C1-J.2 keyless public Reddit limits. These are non-secret and are forwarded only when
# CLUVVI_DISCOVERY_SOURCE_ADAPTER_MODE=selected_sources and the community family is enabled.
# No Reddit OAuth/login/cookies are supported or forwarded; challenges are classified, never bypassed.
DISCOVERY_REDDIT_ENABLED=true
DISCOVERY_REDDIT_DEPTH=default
DISCOVERY_REDDIT_MAX_QUERIES=8
DISCOVERY_REDDIT_MAX_DISCOVERED_SUBREDDITS=20
DISCOVERY_REDDIT_MAX_SELECTED_SUBREDDITS=20
DISCOVERY_REDDIT_MAX_THREADS=100
DISCOVERY_REDDIT_MAX_THREADS_DRILLED_QUICK=3
DISCOVERY_REDDIT_MAX_THREADS_DRILLED_DEFAULT=5
DISCOVERY_REDDIT_MAX_THREADS_DRILLED_DEEP=8
DISCOVERY_REDDIT_MAX_COMMENTS_PER_THREAD=25
DISCOVERY_REDDIT_MAX_TOTAL_COMMENTS=150
DISCOVERY_REDDIT_RSS_TIMEOUT_MS=15000
DISCOVERY_REDDIT_LISTING_TIMEOUT_MS=15000
DISCOVERY_REDDIT_COMMENT_TIMEOUT_MS=15000
DISCOVERY_REDDIT_ENRICH_BUDGET_MS=30000
DISCOVERY_REDDIT_MAX_CONCURRENCY=2
DISCOVERY_REDDIT_MAX_DOMAIN_CONCURRENCY=1
DISCOVERY_REDDIT_MAX_RSS_RESPONSE_BYTES=2097152
DISCOVERY_REDDIT_MAX_HTML_RESPONSE_BYTES=3145728
DISCOVERY_REDDIT_ARCTIC_ENABLED=true
DISCOVERY_REDDIT_ARCTIC_TIMEOUT_MS=15000
DISCOVERY_REDDIT_ARCTIC_BATCH_SIZE=100
DISCOVERY_REDDIT_ARCTIC_MAX_BATCHES=2
DISCOVERY_REDDIT_ARCTIC_PACE_MS=750
DISCOVERY_REDDIT_ARCTIC_CACHE_MAX=500
DISCOVERY_REDDIT_RELEVANCE_FLOOR=0.45
DISCOVERY_REDDIT_CONTENT_SAFETY_FILTER=true

# Optional C1-J.4 bounded public YouTube text-intelligence settings. Project B forwards only
# these non-secret policy/budget values. Cookies, browser profiles, auth, proxy settings, media
# download options, and arbitrary binary paths are intentionally unsupported.
CLUVVI_DISCOVERY_YOUTUBE_DEPTH=default
DISCOVERY_YOUTUBE_ENABLED=true
DISCOVERY_YOUTUBE_DEPTH=default
DISCOVERY_YOUTUBE_MAX_QUERIES=8
DISCOVERY_YOUTUBE_SEARCH_RESULTS_QUICK=8
DISCOVERY_YOUTUBE_SEARCH_RESULTS_DEFAULT=15
DISCOVERY_YOUTUBE_SEARCH_RESULTS_DEEP=25
DISCOVERY_YOUTUBE_MAX_METADATA_DETAILS=20
DISCOVERY_YOUTUBE_TRANSCRIPT_DRILL_QUICK=2
DISCOVERY_YOUTUBE_TRANSCRIPT_DRILL_DEFAULT=5
DISCOVERY_YOUTUBE_TRANSCRIPT_DRILL_DEEP=8
DISCOVERY_YOUTUBE_COMMENTS_ENABLED=true
DISCOVERY_YOUTUBE_MAX_COMMENT_VIDEOS=3
DISCOVERY_YOUTUBE_MAX_COMMENTS_PER_VIDEO=25
DISCOVERY_YOUTUBE_MAX_COMMENTS_TOTAL=100
DISCOVERY_YOUTUBE_CONTENT_SAFETY_FILTER=true

# Optional C1-J.5 Universal Specialized Source Intelligence settings. Tech/AI is Pack #1,
# not a top-level research family. Dynamic discovery is bounded and uses the approved Provider
# Router. The operator-only DISCOVERY_SPECIALIZED_SOURCE_REGISTRY_PATH is deliberately absent
# because Project B must never forward executable/local registry paths into Project A.
DISCOVERY_SPECIALIZED_ENABLED=true
DISCOVERY_SPECIALIZED_MODE=auto
DISCOVERY_SPECIALIZED_DYNAMIC_DISCOVERY=true
DISCOVERY_SPECIALIZED_MAX_PACKS=3
DISCOVERY_SPECIALIZED_MAX_DISCOVERY_QUERIES=6
DISCOVERY_SPECIALIZED_MAX_CANDIDATES=30
DISCOVERY_SPECIALIZED_MAX_SELECTED_SOURCES=8
DISCOVERY_SPECIALIZED_MAX_SITE_QUERIES_PER_SOURCE=2
DISCOVERY_SPECIALIZED_MAX_PAGES_PER_SOURCE=3
DISCOVERY_SPECIALIZED_MAX_FEED_ITEMS_PER_SOURCE=20
DISCOVERY_SPECIALIZED_COVERAGE_THRESHOLD=0.65
DISCOVERY_SPECIALIZED_SOURCE_SCORE_THRESHOLD=0.55
DISCOVERY_SPECIALIZED_MAX_TOTAL_PAGES=20
DISCOVERY_SPECIALIZED_ARXIV_ENABLED=true
DISCOVERY_SPECIALIZED_ARXIV_MAX_RESULTS=30
DISCOVERY_SPECIALIZED_ARXIV_MAX_TOTAL_RESULTS=100
DISCOVERY_SPECIALIZED_ARXIV_REQUEST_DELAY_MS=3000
DISCOVERY_SPECIALIZED_ARXIV_PDF_DRILL_QUICK=0
DISCOVERY_SPECIALIZED_ARXIV_PDF_DRILL_DEFAULT=2
DISCOVERY_SPECIALIZED_ARXIV_PDF_DRILL_DEEP=3
DISCOVERY_SPECIALIZED_TECHMEME_ENABLED=true
DISCOVERY_SPECIALIZED_DIGG_ENABLED=true

# Added in C1; keep empty until a provider is explicitly approved and configured
CLUVVI_LLM_BASE_URL=
CLUVVI_LLM_API_KEY=
CLUVVI_LLM_MODEL=
CLUVVI_LLM_TIMEOUT_MS=90000

# Parked Phase 0 Supabase placeholders
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Parked Phase 0 application defaults
APP_BASE_URL=http://localhost:3100
LOG_LEVEL=info
DEFAULT_RUN_BUDGET_USD=25
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEALTH_PORT=3001
