# Active local Cluvvi runtime
CLUVVI_DEV_HOST=127.0.0.1
CLUVVI_DEV_PORT=3100
CLUVVI_ENGINE_MODE=fixture
CLUVVI_HOME=.cluvvi

# Discovery runtime. Internal fixture remains the safe default.
CLUVVI_DISCOVERY_MODE=fixture
CLUVVI_DISCOVERY_PROVIDER_MODE=fixture_only
CLUVVI_DISCOVERY_ENGINE_PATH=
CLUVVI_DISCOVERY_ENGINE_COMMAND=pnpm
CLUVVI_DISCOVERY_ENGINE_TIMEOUT_MS=60000
CLUVVI_DISCOVERY_KEEP_EXCHANGE_FILES=false

# Optional Project A live-provider overrides. The standalone Discovery Engine also loads its own
# ignored root .env.local. Cluvvi forwards only this explicit allowlist and never logs or persists
# secret values or a complete child environment.
DISCOVERY_LIVE_PROVIDERS=hacker_news_algolia,hacker_news_firebase,tavily_search,brave_web_search
DISCOVERY_HTTP_TIMEOUT_MS=20000
DISCOVERY_HTTP_MAX_ATTEMPTS=2
DISCOVERY_HTTP_CONCURRENCY=2
DISCOVERY_LIVE_MAX_QUERIES=2
DISCOVERY_MAX_RESULTS_PER_PROVIDER=3
DISCOVERY_HN_ALGOLIA_MAX_REQUESTS_PER_RUN=2
DISCOVERY_HN_FIREBASE_MAX_ITEMS_PER_RUN=3
DISCOVERY_TAVILY_MAX_REQUESTS_PER_RUN=2
DISCOVERY_BRAVE_MAX_REQUESTS_PER_RUN=2
DISCOVERY_TAVILY_SEARCH_DEPTH=basic
DISCOVERY_BROAD_PROVIDER_STRATEGY=fanout
DISCOVERY_TAVILY_API_KEY=
DISCOVERY_BRAVE_API_KEY=

# Added in C1; keep empty until a provider is explicitly approved and configured
CLUVVI_LLM_BASE_URL=
CLUVVI_LLM_API_KEY=
CLUVVI_LLM_MODEL=
CLUVVI_LLM_TIMEOUT_MS=90000

# Parked Phase 0 Supabase placeholders
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Parked Phase 0 application defaults
APP_BASE_URL=http://localhost:3100
LOG_LEVEL=info
DEFAULT_RUN_BUDGET_USD=25
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEALTH_PORT=3001
